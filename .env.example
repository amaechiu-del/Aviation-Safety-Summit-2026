# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Optional URL where this app is hosted.
# Some environments may inject this automatically, but the current Cloud Run deployment flow does not require it.
# Keep this only if a hosting environment or future integration needs a public app URL.
APP_URL="MY_APP_URL"

# PAYSTACK_SECRET_KEY: Secret API key for server-side Paystack payment initialization and verification.
PAYSTACK_SECRET_KEY="sk_test_..."

# PAYSTACK_PUBLIC_KEY: Optional public key for client-side Paystack checkout triggers.
# The current Cloud Run deployment flow does not require this because the server does not read it at runtime.
PAYSTACK_PUBLIC_KEY="pk_test_..."
